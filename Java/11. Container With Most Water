class Solution {
    public int maxArea(int[] height) {
        int len = height.length;
        
        int i = 0;
        int j = len-1;
        int max = 0;
        int area;
        while(i<j){
            area = Math.min(height[i],height[j])*(j-i);
            max = Math.max(max,area);
            if(height[i]>height[j]){
                j--;
            }
            else{
                i++;
            }
        }
        return max;
    }
}
