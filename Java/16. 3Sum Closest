class Solution {
    public int threeSumClosest(int[] nums, int target) {
        int len = nums.length;
        int closest=nums[0]+nums[1]+nums[2];
        int sum ;
        Arrays.sort(nums);
        for(int i = 0; i < len-2; i++){
            int j=i+1;
            int k=len-1;

            while(j<k){
                sum=nums[i]+nums[j]+nums[k];
                if(Math.abs(closest-target)>Math.abs(target-sum)){
                closest=sum;
                }
                if (sum == target) {
                return target;
            }
                if (sum<target){
                j++;
                }
                else{
                    k--;
                }
            }
        }
        return closest;
    }
}
