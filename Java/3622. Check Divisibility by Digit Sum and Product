class Solution {
    public boolean checkDivisibility(int n) {
        int sum=0;
        int product=1;
        int temp=n;
        while(n!=0){
            int r= n%10;
            sum+=r;
            product*=r;
            n/=10;
        }
        if(temp%(sum+product)==0){
            return true;
        }
        return false;
    }
}
