class Solution {
    public char nextGreatestLetter(char[] letters, char target) {
        int low=0;
        int high=letters.length-1;
        char t= target;

        while(low<=high){
            int mid = low+(high-low)/2;
            if(letters[mid]<=t){
                low=mid+1;
            }
            else if(letters[mid]>t){
                high=mid-1;
            }
           

        }
        return letters[low%letters.length];
    }
}
