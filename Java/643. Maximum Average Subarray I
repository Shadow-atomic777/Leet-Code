class Solution {
    public double findMaxAverage(int[] nums, int k) {
        double avg=0;
        for(int i =0; i<k;i++){
            avg+=nums[i];
        }   
        double answer= avg;
        for (int i =1; i<=nums.length-k;i++){
            avg-=nums[i-1];
            avg+=nums[i+k-1];
            answer= Math.max(answer,avg);
        }
        return answer/k;

    }
}
