class Solution {
    public int findMin(int[] nums) {
        int ans=0;
        int count=0;
        for(int i =0; i<nums.length-1;i++){
            if(nums[i]>nums[i+1]){
                ans=nums[i+1];
                count++;
                break;
            }
        }
        if(count==0){
            return nums[0];
        }
        return Math.min(ans, nums[0]);
    }
}
