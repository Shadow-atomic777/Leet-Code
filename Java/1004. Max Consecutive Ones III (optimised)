class Solution {
    public int longestOnes(int[] nums, int k) {
        int count =0;
        int ans=0;
        int zeroes=0;
        int left=0;
        for(int right =0; right<nums.length;right++){
            count++;
            if(nums[right]==0){
                zeroes++;
            }
            while(zeroes>k){
                if(nums[left]==0){
                    zeroes--;
                }
                count--;
                left++;
            }
            ans=Math.max(ans,count);
        }   
        return ans;
    }

}
