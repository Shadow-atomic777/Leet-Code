class Solution {
    public int numSubarraysWithSum(int[] nums, int goal) {
        HashMap<Integer, Integer> map = new HashMap<>();
        map.put(0,1);
        int prefix=0;
        int count=0;
        for (int i=0; i<nums.length;i++){
            prefix+= nums[i];
            int curr = prefix-goal;
            if(map.containsKey(curr)){
                count+=map.get(curr);
            }
            
                map.put(prefix, map.getOrDefault(prefix, 0)+1);
           
        }
        return count;
        
    }
}
