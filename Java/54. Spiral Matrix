class Solution {
    public List<Integer> spiralOrder(int[][] matrix) {
        int s_r=0;
        int e_r=matrix.length-1;
        int s_c=0;
        int e_c=matrix[0].length-1;
        List<Integer> ans= new ArrayList<>();
        while(s_r<=e_r &&  s_c<=e_c){
            for(int i=s_c; i<=e_c; i++){
                ans.add(matrix[s_r][i]);
                
            }
            s_r++;
            for(int i=s_r; i<=e_r; i++ ){
                ans.add(matrix[i][e_c]);
               
            }
            e_c--;
            if(s_r<=e_r){
            for(int i=e_c; i>=s_c;i--){
                ans.add(matrix[e_r][i]);
                }
            }
            e_r--;
            if(s_c<=e_c){
            for(int i=e_r;i>=s_r;i--){
                ans.add(matrix[i][s_c]);
                }
            }
            s_c++;
        }
        return ans;
    }
}
