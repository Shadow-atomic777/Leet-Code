class Solution {
    public int subarraySum(int[] nums, int k) {
       
        HashMap<Integer, Integer> freq = new HashMap<>();
        freq.put(0,1);
        int prefix= 0;
        int count=0;
        for(int i=0; i<nums.length ; i++){
            prefix += nums[i]; 
            int a = prefix - k;
            if(freq.containsKey(a)){
                count+=freq.get(a);
            }
            freq.put(prefix, freq.getOrDefault(prefix, 0) + 1);
        }

        return count;
        
    }
}
