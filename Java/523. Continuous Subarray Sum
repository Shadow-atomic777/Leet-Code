class Solution {
    public boolean checkSubarraySum(int[] nums, int k) {
        HashMap<Integer, Integer> map =new  HashMap<>();
        map.put(0,-1);
        int prefix=0;
        for(int i=0;i<nums.length;i++){
            prefix+=nums[i];
            int curr = prefix%k;
            if(map.containsKey(curr)){
                
                if(i-map.get(curr)>=2){
                    return true;
                }
            }
            else{
                map.put(curr,i);
                }

        }
        return false;
    }
}
